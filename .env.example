# canton-agent-mandate — DevNet environment template.
#
# Copy to .env (which is gitignored), fill in the values from the Cantor8 team,
# then load it into your shell before running the adapter or the preflight:
#
#     cp .env.example .env
#     # edit .env, paste the real secret
#     source .env
#     python3 adapter/doctor.py
#
# NEVER commit real values. .env is ignored by git; .env.example must stay
# secret-free.

# Ledger API base (DevNet). Setting C8_IDP is what flips c8lab from LocalNet
# (self-signed HS256) into DevNet (real Keycloak client-credentials) mode.
export C8_BASE=https://api.validator.dev.digik.cantor8.tech/api/ledger
export C8_IDP=https://auth.dev.digik.cantor8.tech

# Keycloak client. The secret comes from the Cantor8 team — do not paste it here.
export C8_CLIENT_ID=hackathon
export C8_CLIENT_SECRET=

# Token registry base — required for any transfer. Ask the team for the DevNet
# registry host. Only set C8_REGISTRY_HOST if that deployment routes by Host.
export C8_REGISTRY=
# export C8_REGISTRY_HOST=

# Where the toolkit's c8lab.py lives. Default is ~/hackathon-toolkit/c8lab.py;
# uncomment to override. We reuse it in place and never vendor it.
# export C8LAB=$HOME/hackathon-toolkit/c8lab.py
